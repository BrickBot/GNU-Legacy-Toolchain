+
+#include "complex.h"
+
+complex_char
+complex_char_ctor (char the_re, char the_im)
+{
+  complex_char result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_short
+complex_short_ctor (short the_re, short the_im)
+{
+  complex_short result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_int
+complex_int_ctor (int the_re, int the_im)
+{
+  complex_int result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_long
+complex_long_ctor (long the_re, long the_im)
+{
+  complex_long result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_uchar
+complex_uchar_ctor (unsigned char the_re, unsigned char the_im)
+{
+  complex_uchar result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_ushort
+complex_ushort_ctor (unsigned short the_re, unsigned short the_im)
+{
+  complex_ushort result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_uint
+complex_uint_ctor (unsigned int the_re, unsigned int the_im)
+{
+  complex_uint result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_ulong
+complex_ulong_ctor (unsigned long the_re, unsigned long the_im)
+{
+  complex_ulong result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_float
+complex_float_ctor (float the_re, float the_im)
+{
+  complex_float result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
+
+complex_double
+complex_double_ctor (double the_re, double the_im)
+{
+  complex_double result;
+  result.re = the_re;
+  result.im = the_im;
+  return result;
+}
