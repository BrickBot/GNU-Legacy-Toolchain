+typedef struct COMPLEX_CHAR { char re; char im; } complex_char;
+typedef struct COMPLEX_UCHAR { unsigned char re; unsigned char im; } complex_uchar;
+
+typedef struct COMPLEX_SHORT { short re; short im; } complex_short;
+typedef struct COMPLEX_USHORT { unsigned short re; unsigned short im; } complex_ushort;
+
+typedef struct COMPLEX_INT { int re; int im; } complex_int;
+typedef struct COMPLEX_UINT { unsigned int re; unsigned int im; } complex_uint;
+
+typedef struct COMPLEX_LONG { long re; long im; } complex_long;
+typedef struct COMPLEX_ULONG { unsigned long re; unsigned long im; } complex_ulong;
+
+typedef struct COMPLEX_FLOAT { float re; float im; } complex_float;
+
+typedef struct COMPLEX_DOUBLE { double re; double im; } complex_double;
