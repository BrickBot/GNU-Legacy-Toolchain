+.PHONY: configure-target-libcilsupport maybe-configure-target-libcilsupport
+maybe-configure-target-libcilsupport:
+@if gcc-bootstrap
+configure-target-libcilsupport: stage_current
+@endif gcc-bootstrap
+@if target-libcilsupport
+maybe-configure-target-libcilsupport: configure-target-libcilsupport
+configure-target-libcilsupport: 
+	@: $(MAKE); $(unstage)
+	@r=`${PWD_COMMAND}`; export r; \
+	s=`cd $(srcdir); ${PWD_COMMAND}`; export s; \
+	echo "Checking multilib configuration for libcilsupport..."; \
+	$(SHELL) $(srcdir)/mkinstalldirs $(TARGET_SUBDIR)/libcilsupport ; \
+	$(CC_FOR_TARGET) --print-multi-lib > $(TARGET_SUBDIR)/libcilsupport/multilib.tmp 2> /dev/null ; \
+	if test -r $(TARGET_SUBDIR)/libcilsupport/multilib.out; then \
+	  if cmp -s $(TARGET_SUBDIR)/libcilsupport/multilib.tmp $(TARGET_SUBDIR)/libcilsupport/multilib.out; then \
+	    rm -f $(TARGET_SUBDIR)/libcilsupport/multilib.tmp; \
+	  else \
+	    rm -f $(TARGET_SUBDIR)/libcilsupport/Makefile; \
+	    mv $(TARGET_SUBDIR)/libcilsupport/multilib.tmp $(TARGET_SUBDIR)/libcilsupport/multilib.out; \
+	  fi; \
+	else \
+	  mv $(TARGET_SUBDIR)/libcilsupport/multilib.tmp $(TARGET_SUBDIR)/libcilsupport/multilib.out; \
+	fi; \
+	test ! -f $(TARGET_SUBDIR)/libcilsupport/Makefile || exit 0; \
+	$(SHELL) $(srcdir)/mkinstalldirs $(TARGET_SUBDIR)/libcilsupport ; \
+	$(NORMAL_TARGET_EXPORTS) \
+	echo Configuring in $(TARGET_SUBDIR)/libcilsupport; \
+	cd "$(TARGET_SUBDIR)/libcilsupport" || exit 1; \
+	case $(srcdir) in \
+	  /* | [A-Za-z]:[\\/]*) topdir=$(srcdir) ;; \
+	  *) topdir=`echo $(TARGET_SUBDIR)/libcilsupport/ | \
+		sed -e 's,\./,,g' -e 's,[^/]*/,../,g' `$(srcdir) ;; \
+	esac; \
+	srcdiroption="--srcdir=$${topdir}/libcilsupport"; \
+	libsrcdir="$$s/libcilsupport"; \
+	rm -f no-such-file || : ; \
+	CONFIG_SITE=no-such-file $(SHELL) $${libsrcdir}/configure \
+	  $(TARGET_CONFIGARGS) --build=${build_alias} --host=${target_alias} \
+	  --target=${target_alias} $${srcdiroption}  \
+	  || exit 1
+@endif target-libcilsupport
