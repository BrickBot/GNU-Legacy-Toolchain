Subject: gcc 4.4.7 subdirectories: fix AC_CHECK_FUNCS link test so it is not folded away by -flto

Same fix as gcc-4.4.7-fprintf_unlocked-lto-fix.patch, applied to the remaining
GCC subdirectories that carry the old "return f != FUNC;" test (boehm-gc,
fixincludes, intl, libcilsupport, libcpp, libffi, libgfortran, libgomp, libjava,
libmudflap, libobjc, libssp, libstdc++-v3, zlib).  Without it, fixincludes
falsely detects fprintf_unlocked under -flto and fails to link.
---
--- a/boehm-gc/configure
+++ b/boehm-gc/configure
@@ -11164,8 +11164,6 @@
     something starting with __ and the normal name is an alias.  */
 #if defined (__stub_shl_load) || defined (__stub___shl_load)
 choke me
-#else
-char (*f) () = shl_load;
 #endif
 #ifdef __cplusplus
 }
@@ -11174,7 +11172,7 @@
 int
 main ()
 {
-return f != shl_load;
+return shl_load ();
   ;
   return 0;
 }
@@ -11334,8 +11332,6 @@
     something starting with __ and the normal name is an alias.  */
 #if defined (__stub_dlopen) || defined (__stub___dlopen)
 choke me
-#else
-char (*f) () = dlopen;
 #endif
 #ifdef __cplusplus
 }
@@ -11344,7 +11340,7 @@
 int
 main ()
 {
-return f != dlopen;
+return dlopen ();
   ;
   return 0;
 }
@@ -16378,8 +16374,6 @@
     something starting with __ and the normal name is an alias.  */
 #if defined (__stub_$ac_func) || defined (__stub___$ac_func)
 choke me
-#else
-char (*f) () = $ac_func;
 #endif
 #ifdef __cplusplus
 }
@@ -16388,7 +16382,7 @@
