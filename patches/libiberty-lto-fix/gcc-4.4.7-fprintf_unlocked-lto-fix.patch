Subject: gcc: fix AC_CHECK_FUNCS link test so it is not folded away by -flto

Autoconf's AC_CHECK_FUNCS test compares a global function pointer to
the function itself ("return f != FUNC;").  Under -flto that comparison
is constant-folded and the reference to FUNC is dropped, so the test
passes even when the function is absent.  For fprintf_unlocked, which
glibc lacks, this defines HAVE_FPRINTF_UNLOCKED; system.h then maps
fprintf to fprintf_unlocked and host tools such as gen-protos fail to
link.  Override AC_LANG_FUNC_LINK_TRY(C) in aclocal.m4 to call the
function, as later Autoconf releases do, and update the generated tests
in configure to match.
---
--- a/gcc/configure
+++ b/gcc/configure
@@ -10200,8 +10200,6 @@
     something starting with __ and the normal name is an alias.  */
 #if defined (__stub_$ac_func) || defined (__stub___$ac_func)
 choke me
-#else
-char (*f) () = $ac_func;
 #endif
 #ifdef __cplusplus
 }
@@ -10210,7 +10208,7 @@
 int
 main ()
 {
-return f != $ac_func;
+return $ac_func ();
   ;
   return 0;
 }
@@ -10681,8 +10679,6 @@
     something starting with __ and the normal name is an alias.  */
 #if defined (__stub_mmap) || defined (__stub___mmap)
 choke me
-#else
-char (*f) () = mmap;
 #endif
 #ifdef __cplusplus
 }
@@ -10691,7 +10687,7 @@
 int
 main ()
 {
-return f != mmap;
+return mmap ();
   ;
   return 0;
 }
