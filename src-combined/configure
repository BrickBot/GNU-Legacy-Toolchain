#!/bin/bash

# Variable declarations and initializations
SRC_DIR=$(realpath -s $(dirname $0))
GCC3_SUBDIR=gcc3-combined
GCC44_SUBDIR=gcc44-combined
CIL_SUBDIR=gcc-cil-fe
GDB_SUBDIR=gdb
GCC3_SRC_DIR=$SRC_DIR/$GCC3_SUBDIR
GCC44_SRC_DIR=$SRC_DIR/$GCC44_SUBDIR
CIL_SRC_DIR=$SRC_DIR/$CIL_SUBDIR
GDB_SRC_DIR=$SRC_DIR/$GDB_SUBDIR

BUILD_DIR=$PWD
GCC3_BUILD_DIR=$BUILD_DIR/$GCC3_SUBDIR
GCC44_BUILD_DIR=$BUILD_DIR/$GCC44_SUBDIR
CIL_BUILD_DIR=$BUILD_DIR/$CIL_SUBDIR
GDB_BUILD_DIR=$BUILD_DIR/$GDB_SUBDIR
MAKEFILE_PATH=$BUILD_DIR/Makefile

ARG_DELIM=,

# Define defaults
prefix=/opt/stow/gnu-legacy-toolchain
# Ada excluded from languages because it cannot bootstrap
languages=c,c++,f77,java,objc,treelang,pascal

# Check if a high-level component should be included.
# In this case, the return value is the exit code,
#    so zero means include and non-zero means exclude.
isIncluded() {
  if [ ${#1} -gt 0 -a ${#2} -gt 0 ] ; then
    # Case-independent substring check written for improved portability
    case $1 in *${ARG_DELIM}${2,,}${ARG_DELIM}* ) result=0;; *) result=1;; esac ;
  else
    # No sets specified, so automatically include the current one
    result=0
  fi
  
  return $(( result ))
}

# Process command-line arguments
ARGS=( "$@" )
i=0
for ARG in "${ARGS[@]}"; do
  case "$ARG" in
    --prefix=*)
      prefix="${ARG#*=}"
      # Don't directly pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --enable-languages=*)
      languages="${ARG#*=}"
      # Don't directly pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --toolchain-sets=*)
      # Only configure specific high-level toolchain sets
      # Bracket with the delimiters to simplify substring checking
      toolchain_sets="${ARG_DELIM}${ARG#*=}${ARG_DELIM}"
      # Don't pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --stow-target=*)
      STOW_TARGET=$(realpath -s "${ARG#*=}")
      # Don't pass this argument along to sub-configures
      unset ARGS[i]
      ;;
#    "--with-gpc-shared=no" | "--without-gpc-shared")
#      GCC_MAKE_ARGS="WITH_GPC_SHARED=no"
#      ;;
#    "--with-gpc-shared" | "--with-gpc-shared=yes")
#      WITH_GPC_SHARED=yes
#      ;;
    *)
      ;;
  esac
  ((++i))
done

if [ ${#ARGS[@]} -gt 0 ]; then
  if [ ${#ARGS[@]} -ne ${#@} ]; then
    # Rebuild the array indices following array modification
    ARGS=("${ARGS[@]}")
  fi
  ARGS_TO_PASS=$(printf -- '"%s" ' "${ARGS[@]}")
fi


# Generate Makefile
echo "Generate top-level Makefile"

TARGETS_TO_GENERATE="all info dvi clean mostlyclean distclean maintainer-clean realclean check etags tags uninstall install"

cat > $MAKEFILE_PATH <<MAKEFILE_HEADER
# DO NOT EDIT: This file is autogenerated by $(basename $0)
#   located at $SRC_DIR
#
# NOTE: Make is executed on GDB before GCC because for targets
#       like install, files from GCC need to take precedence
#       when there are duplicates (mostly in documentation)

# ABOUT PARTICULAR TARGETS:
#  * installcheck: This target performs installation tests (if any), which requires a build and install of the program before running.
#      Since at this aggregate level we are doing modified installs, installcheck has been excluded at this aggregate level.
#  * dist:  Per the root Makefile.in for GCC, building a full distribution is not done via this target.

# Properties
prefix ?= $prefix

# Normalize for path prepending (remove any trailing slash)
# Use \$(abspath dir) instead of \$(realpath dir) since this path might not exist
ifdef DESTDIR
DESTDIR := \$(abspath \$(DESTDIR))
endif

ifdef prefix
prefix := \$(abspath \$(prefix))
endif

# The outer realpath is needed to remove the trailing slash that dir leaves behind
BUILD_DIR := \$(realpath \$(dir \$(realpath \$(lastword \$(MAKEFILE_LIST)))))
GCC3_SUBDIR ?= $GCC3_SUBDIR
GCC44_SUBDIR ?= $GCC44_SUBDIR
CIL_SUBDIR ?= $CIL_SUBDIR
GDB_SUBDIR ?= $GDB_SUBDIR
GCC3_BUILD_DIR = \$(BUILD_DIR)/\$(GCC3_SUBDIR)
GCC44_BUILD_DIR = \$(BUILD_DIR)/\$(GCC44_SUBDIR)
CIL_BUILD_DIR = \$(BUILD_DIR)/\$(CIL_SUBDIR)
GDB_BUILD_DIR = \$(BUILD_DIR)/\$(GDB_SUBDIR)

# Targets
#
MAKEFILE_HEADER

for TARGET in $TARGETS_TO_GENERATE
do
  if [ "$TARGET" != "install" ] ; then
    echo "$TARGET: $TARGET-cil $TARGET-gdb $TARGET-gcc3 $TARGET-gcc44" >> $MAKEFILE_PATH
  else
    cat >> $MAKEFILE_PATH <<MAKEFILE_INSTALL_TARGET_GEN
# For a combined install, each sub-install must be executed in a specific,
#  sequential order to preserve precedence and avoid improper file overwrites.
$TARGET:
	\$(MAKE) $TARGET-cil  
	\$(MAKE) $TARGET-gdb  
	\$(MAKE) $TARGET-gcc3 
	\$(MAKE) $TARGET-gcc44
MAKEFILE_INSTALL_TARGET_GEN
  fi
  cat >> $MAKEFILE_PATH <<MAKEFILE_TARGET_GEN
$TARGET-cil:
	@echo "MAKE: CIL v4.3 - $TARGET" && cd "\$(CIL_BUILD_DIR)"   && \$(MAKE) \$(CIL_MAKE_ARGS)   $TARGET-cil
$TARGET-gdb:
	@echo "MAKE: GDB v7 - $TARGET"   && cd "\$(GDB_BUILD_DIR)"   && \$(MAKE) \$(GDB_MAKE_ARGS)   $TARGET
$TARGET-gcc3:
	@echo "MAKE: GCC v3 - $TARGET"   && cd "\$(GCC3_BUILD_DIR)"  && \$(MAKE) \$(GCC3_MAKE_ARGS)  $TARGET
$TARGET-gcc44:
	@echo "MAKE: GCC v4.4 - $TARGET" && cd "\$(GCC44_BUILD_DIR)" && \$(MAKE) \$(GCC44_MAKE_ARGS) $TARGET
.PHONY:  $TARGET $TARGET-cil $TARGET-gdb $TARGET-gcc3 $TARGET-gcc44

MAKEFILE_TARGET_GEN
done

# The ""dist" target require special handling
cat >> $MAKEFILE_PATH <<MAKEFILE_FOOTER
# Regarding this dist target comment, see the root Makefile.in for GCC
dist:
	@echo "Building a full distribution of this tree isn't done via 'make \$@'."
.PHONY:  dist


include Makefile.utility
MAKEFILE_FOOTER

# Include the utility Makefile
cp "$SRC_DIR/Makefile.utility" "$BUILD_DIR/"


# Execute configure scripts for GCC and GDB

# For any quoted substrings in variables (such as $ARGS_TO_PASS might have)
#   to be properly processed as a single quoted argument,
#   the command must be eval'd instead of being executed directly.
#   c.f. https://stackoverflow.com/q/39583838/#comment66478321_39583915
if isIncluded "$toolchain_sets" "CIL" ; then
  echo "==================="
  echo "CONFIGURE: CIL v4.3"
  CIL_COMMAND="$CIL_SRC_DIR/configure --enable-languages=cil $ARGS_TO_PASS  CFLAGS='-g -O2 -std=gnu89 -fgnu89-inline' --without-build-libsubdir --prefix=$prefix "
  echo "COMMAND: $CIL_COMMAND"
  mkdir -p "$CIL_BUILD_DIR" && pushd "$CIL_BUILD_DIR" > /dev/null
  eval "$CIL_COMMAND" || exit 1
  popd > /dev/null
fi

if isIncluded "$toolchain_sets" "GDB" ; then
  echo "================="
  echo "CONFIGURE: GDB v7"
  GDB_COMMAND="$GDB_SRC_DIR/configure $ARGS_TO_PASS  CFLAGS='-g -O2 -std=gnu89' CXXFLAGS='-g -O2 -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++98'  --without-python --prefix=$prefix "
  echo "COMMAND: $GDB_COMMAND"
  mkdir -p "$GDB_BUILD_DIR" && pushd "$GDB_BUILD_DIR" > /dev/null
  eval "$GDB_COMMAND" || exit 1
  popd > /dev/null
fi

if isIncluded "$toolchain_sets" "GCC3" ; then
  echo "================="
  echo "CONFIGURE: GCC v3"
  GCC3_COMMAND="CFLAGS='-g -O2 -std=gnu89'  $GCC3_SRC_DIR/configure --enable-languages=$languages $ARGS_TO_PASS --prefix=$prefix "
  echo "COMMAND: $GCC3_COMMAND"
  mkdir -p "$GCC3_BUILD_DIR" && pushd "$GCC3_BUILD_DIR" > /dev/null
  eval "$GCC3_COMMAND" || exit 1
  popd > /dev/null
fi

if isIncluded "$toolchain_sets" "GCC44" ; then
  echo "==================="
  echo "CONFIGURE: GCC v4.4"
  GCC44_COMMAND="$GCC44_SRC_DIR/configure  CFLAGS='-g -O2 -std=gnu89'  --enable-languages=c,c++,java $ARGS_TO_PASS --enable-obsolete --prefix=$prefix "
  echo "COMMAND: $GCC44_COMMAND"
  mkdir -p "$GCC44_BUILD_DIR" && pushd "$GCC44_BUILD_DIR" > /dev/null
  eval "$GCC44_COMMAND" || exit 1
  popd > /dev/null
fi
