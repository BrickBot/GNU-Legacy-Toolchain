#!/bin/bash

# Variable declarations and initializations
SRC_DIR=$(realpath -s $(dirname $0))
GCC_SUBDIR=gcc-combined
CIL_SUBDIR=gcc-cil-fe
GDB_SUBDIR=gdb
GCC_SRC_DIR=$SRC_DIR/$GCC_SUBDIR
CIL_SRC_DIR=$SRC_DIR/$CIL_SUBDIR
GDB_SRC_DIR=$SRC_DIR/$GDB_SUBDIR

BUILD_DIR=$PWD
GCC_BUILD_DIR=$BUILD_DIR/$GCC_SUBDIR
CIL_BUILD_DIR=$BUILD_DIR/$CIL_SUBDIR
GDB_BUILD_DIR=$BUILD_DIR/$GDB_SUBDIR
MAKEFILE_PATH=$BUILD_DIR/Makefile

# Define defaults
prefix=/opt/stow/gcc3
# Ada excluded from languages because it cannot bootstrap
languages=c,c++,f77,java,objc,pascal
STOW_TARGET=/usr/local

# Process command-line arguments
ARGS=( "$@" )
i=0
for ARG in "${ARGS[@]}"; do
  case "$ARG" in
    --prefix=*)
      prefix="${ARG#*=}"
      # Don't directly pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --enable-languages=*)
      languages="${ARG#*=}"
      # Don't directly pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --stow-target=*)
      STOW_TARGET=$(realpath -s "${ARG#*=}")
      # Don't pass this argument along to sub-configures
      unset ARGS[i]
      ;;
#    "--with-gpc-shared=no" | "--without-gpc-shared")
#      GCC_MAKE_ARGS="WITH_GPC_SHARED=no"
#      ;;
#    "--with-gpc-shared" | "--with-gpc-shared=yes")
#      WITH_GPC_SHARED=yes
#      ;;
    *)
      ;;
  esac
  ((++i))
done

if [ ${#ARGS[@]} -gt 0 ]; then
  if [ ${#ARGS[@]} -ne ${#@} ]; then
    # Rebuild the array indices following array modification
    ARGS=("${ARGS[@]}")
  fi
  ARGS_TO_PASS=$(printf -- '"%s" ' "${ARGS[@]}")
fi


# Generate Makefile
echo "Generate top-level Makefile"

TARGETS_TO_GENERATE="all info dvi clean mostlyclean distclean maintainer-clean realclean check install uninstall etags tags"
TARGET_LIST_VARIABLES="list-variables"


cat > $MAKEFILE_PATH <<MAKEFILE_HEADER
# DO NOT EDIT: This file is autogenerated by $(basename $0)
#   located at $SRC_DIR
#
# NOTE: Make is executed on GDB before GCC because for targets
#       like install, files from GCC need to take precedence
#       when there are duplicates (mostly in documentation)

# ABOUT PARTICULAR TARGETS:
#  * installcheck: This target performs installation tests (if any), which requires a build and install of the program before running.
#      Since at this aggregate level we are doing modified installs, installcheck has been excluded at this aggregate level.
#  * dist:  Per the root Makefile.in for GCC, building a full distribution is not done via this target.

# Properties
prefix ?= $prefix

# Normalize for path prepending (remove any trailing slash)
# Cannot use \$(realpath \$(dir)) since this path might not exist
ifneq (\$(DESTDIR),)
DESTDIR_PREPEND = \$(patsubst %/,%,\$(DESTDIR))
endif

ifneq (\$(prefix),)
prefix := \$(patsubst %/,%,\$(prefix))
endif

# The outer realpath is needed to remove the trailing slash that dir leaves behind
BUILD_DIR := \$(realpath \$(dir \$(realpath \$(lastword \$(MAKEFILE_LIST)))))
GCC_SUBDIR ?= $GCC_SUBDIR
CIL_SUBDIR ?= $CIL_SUBDIR
GDB_SUBDIR ?= $GDB_SUBDIR
GCC_BUILD_DIR = \$(BUILD_DIR)/\$(GCC_SUBDIR)
CIL_BUILD_DIR = \$(BUILD_DIR)/\$(CIL_SUBDIR)
GDB_BUILD_DIR = \$(BUILD_DIR)/\$(GDB_SUBDIR)

STOW_TARGET ?= $STOW_TARGET
STOW_PACKAGE_PATH ?= \$(DESTDIR_PREPEND)\$(prefix)
STOW_DIR ?= \$(dir \$(STOW_PACKAGE_PATH))
STOW_PACKAGE = \$(shell basename \$(STOW_PACKAGE_PATH))
STOW_STANDARD_ARGS = --dir=\$(STOW_DIR) --target=\$(STOW_TARGET) --verbose

# Targets

MAKEFILE_HEADER

for TARGET in $TARGETS_TO_GENERATE
do
  cat >> $MAKEFILE_PATH <<MAKEFILE_TARGET_GEN
$TARGET:
	@echo "MAKE: CIL - \$@" && cd "\$(CIL_BUILD_DIR)" && \$(MAKE) $CIL_MAKE_ARGS \$@-cil
	@echo "MAKE: GDB - \$@" && cd "\$(GDB_BUILD_DIR)" && \$(MAKE) $GDB_MAKE_ARGS \$@
	@echo "MAKE: GCC - \$@" && cd "\$(GCC_BUILD_DIR)" && \$(MAKE) $GCC_MAKE_ARGS \$@

MAKEFILE_TARGET_GEN
done

cat >> $MAKEFILE_PATH <<MAKEFILE_FOOTER
# Regarding this dist target comment, see the root Makefile.in for GCC
dist:
	@echo "Building a full distribution of this tree isn't done via 'make \$@'."


# Defining STOW_DIR as a prerequisite of stow and
#  install as a prerequitise of STOW_DIR still causes
#  the install target to executed every time, even if
#  configured as an order-only prerequisite.  Thus,
#  we check for STOW_DIR and trigger install manually.
stow:
ifeq (,\$(wildcard \$(STOW_PACKAGE_PATH)))
	\$(MAKE)  install
endif
	stow \$(STOW_STANDARD_ARGS) --stow "\$(STOW_PACKAGE)"

restow:
	stow \$(STOW_STANDARD_ARGS) --restow "\$(STOW_PACKAGE)"

unstow:
	stow \$(STOW_STANDARD_ARGS) --delete "\$(STOW_PACKAGE)"


$TARGET_LIST_VARIABLES:
	\$(foreach v, \\
		\$(shell echo "\$(filter-out .VARIABLES,\$(.VARIABLES))" | tr ' ' '\n' | sort), \\
		\$(info \$(shell printf "%-20s" "\$(v)")= \$(value \$(v))) \\
	)

MAKEFILE_FOOTER

echo ".PHONY: $TARGETS_TO_GENERATE stow restow unstow $TARGET_LIST_VARIABLES" >> $MAKEFILE_PATH


# Execute configure scripts for GCC and GDB

# For any quoted substrings in variables (such as $ARGS_TO_PASS might have)
#   to be properly processed as a single quoted argument,
#   the command must be eval'd instead of being executed directly.
#   c.f. https://stackoverflow.com/q/39583838/#comment66478321_39583915
echo "=============="
echo "CONFIGURE: CIL"
CIL_COMMAND="$CIL_SRC_DIR/configure --enable-languages=cil $ARGS_TO_PASS  CFLAGS='-g -O2 -std=gnu89 -fgnu89-inline' --prefix=$prefix "
echo "COMMAND: $CIL_COMMAND"
mkdir -p "$CIL_BUILD_DIR" && pushd "$CIL_BUILD_DIR" > /dev/null
eval "$CIL_COMMAND" || exit 1
popd > /dev/null

echo "=============="
echo "CONFIGURE: GDB"
GDB_COMMAND="$GDB_SRC_DIR/configure $ARGS_TO_PASS  CFLAGS='-g -O2 -std=gnu89' CXXFLAGS='-g -O2 -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++98'  --without-python --prefix=$prefix "
echo "COMMAND: $GDB_COMMAND"
mkdir -p "$GDB_BUILD_DIR" && pushd "$GDB_BUILD_DIR" > /dev/null
eval "$GDB_COMMAND" || exit 1
popd > /dev/null

echo "=============="
echo "CONFIGURE: GCC"
GCC_COMMAND="CFLAGS='-g -O2 -std=gnu89'  $GCC_SRC_DIR/configure --enable-languages=$languages $ARGS_TO_PASS --prefix=$prefix "
echo "COMMAND: $GCC_COMMAND"
mkdir -p "$GCC_BUILD_DIR" && pushd "$GCC_BUILD_DIR" > /dev/null
eval "$GCC_COMMAND" || exit 1
popd > /dev/null
