#!/bin/bash

# Constants
ALL_TOOLCHAIN_SETS="gdb5 binutils216 gcc3 gcc44"
gcc3_languages=c,c++,f77,java,objc,treelang,pascal
gcc44_languages=c,c++,java,cil
# NOTE: Ada is excluded from the language lists because it cannot bootstrap

# Variable declarations and initializations
COMBINED_SRC_DIR=$(realpath -s $(dirname $0))
BUILD_DIR=$PWD

MAKEFILE_PATH=$BUILD_DIR/Makefile

ARG_DELIM=,

# Defaults
DEFAULT_PREFIX_ROOT=/opt/stow

# Check if a high-level component should be included.
# In this case, the function return value is treated as an exit code,
#    so zero means include and non-zero means exclude.
isIncluded() {
  if [ ${#1} -gt 0 -a ${#2} -gt 0 ] ; then
    # Case-independent substring check written for improved portability
    case $1 in *${ARG_DELIM}${2,,}${ARG_DELIM}* ) result=0;; *) result=1;; esac ;
  else
    # No sets specified, so automatically include the current one
    result=0
  fi
  
  return $(( result ))
}

# Process command-line arguments
ARGS=( "$@" )
i=0
for ARG in "${ARGS[@]}" ; do
  case "$ARG" in
    --prefix=*)
      prefix="${ARG#*=}"
      # Don't directly pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --program-prefix=*)
      program_prefix="${ARG#*=}"
      # We only need to read this value (if it was provided)
      ;;
    --target=*)
      target="${ARG#*=}"
      # We only need to read this value (if it was provided)
      ;;
    --enable-languages=*)
      languages="${ARG#*=}"
      # Don't directly pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --toolchain-sets=*)
      # Only configure specific high-level toolchain sets
      # Bracket with the delimiters to simplify substring checking
      toolchain_sets="${ARG_DELIM}${ARG#*=}${ARG_DELIM}"
      # Don't pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --toolchain-sets-name=*)
      toolchain_sets_name="${ARG#*=}"
      # Don't directly pass this argument along to sub-configures
      unset ARGS[i]
      ;;
    --stow-target=*)
      STOW_TARGET=$(realpath -s "${ARG#*=}")
      # Don't pass this argument along to sub-configures
      unset ARGS[i]
      ;;
#    "--with-gpc-shared=no" | "--without-gpc-shared")
#      GCC_MAKE_ARGS="WITH_GPC_SHARED=no"
#      ;;
#    "--with-gpc-shared" | "--with-gpc-shared=yes")
#      WITH_GPC_SHARED=yes
#      ;;
    *)
      ;;
  esac
  i=$(expr $i + 1)
done

# Additional argument processing now that all command-line arguments have been identified

# Prepare pass-through arguments, ensuring that there is proper argument quoting
if [ ${#ARGS[@]} -gt 0 ] ; then
  if [ ${#ARGS[@]} -ne ${#@} ] ; then
    # Rebuild the array indices following array modification
    ARGS=("${ARGS[@]}")
  fi
  ARGS_TO_PASS=$(printf -- '"%s" ' "${ARGS[@]}")
fi

# If a program suffix is provided, GNU will not automatically make the target
#   alias the program prefix.  Given that we are working with legacy versions,
#   specifying a program suffix can be useful. So, if a program prefix has not
#   aleady been specified by the user, we need to manually make the target
#   alias the program prefix.
if [ -n "$target" -a -z "$program_prefix" ] ; then
  program_prefix="${target}-"
  ARGS_TO_PASS="$ARGS_TO_PASS \"--program-prefix=${program_prefix}\""
fi

# Set the default prefix if one has not been specified
if [ "$prefix" = "" ] ; then
  if [ "$toolchain_sets_name" = "" ] ; then
    for TOOLCHAIN_SET in $(echo "$ALL_TOOLCHAIN_SETS" | sed -e "s, ,\n,g" | tac)
    do
      if isIncluded "$toolchain_sets" "$TOOLCHAIN_SET" ; then
        if [ "$toolchain_sets_name" != "" ] ; then
          toolchain_sets_name="${toolchain_sets_name}+${TOOLCHAIN_SET}"
        else
          toolchain_sets_name="${TOOLCHAIN_SET}"
        fi
      fi
    done
  fi
  
  if [ "$toolchain_sets_name" != "" ] ; then
    toolchain_sets_name="${program_prefix}${toolchain_sets_name}"
  elif [ "$target" != "" ] ; then
    toolchain_sets_name="${program_prefix}gnu-legacy-toolchain"
  fi
  
  prefix="${DEFAULT_PREFIX_ROOT}/${toolchain_sets_name}"
fi

# Generate Makefile
echo "Generate top-level Makefile"

TARGETS_TO_GENERATE="all info dvi clean mostlyclean distclean maintainer-clean realclean check etags tags uninstall install install-info"

cat > $MAKEFILE_PATH <<MAKEFILE_HEADER
# DO NOT EDIT: This file is autogenerated by $(basename $0)
#   located at $COMBINED_SRC_DIR
#
# NOTE: Make order is based on the needed precedence handling
#       when there are duplicates (mostly in documentation)

# ABOUT PARTICULAR TARGETS:
#  * dist:  Per the root Makefile.in for GCC, building a full distribution is not done via this target.
#  * install:  For a combined install, each sub-install must be executed in a specific,
#      sequential order to preserve precedence and avoid improper file overwrites.
#  * installcheck:  This target performs installation tests (if any), which requires a build and install of the program before running.
#      Since at this aggregate level we are doing modified installs, installcheck has been excluded at this aggregate level.

# Properties
prefix ?= $prefix

# Normalize for path prepending (remove any trailing slash)
# Use \$(abspath dir) instead of \$(realpath dir) since this path might not exist
ifdef DESTDIR
DESTDIR := \$(abspath \$(DESTDIR))
endif

ifdef prefix
prefix := \$(abspath \$(prefix))
endif

# The outer realpath is needed to remove the trailing slash that dir leaves behind
BUILD_DIR := \$(realpath \$(dir \$(realpath \$(lastword \$(MAKEFILE_LIST)))))

# Targets
#
MAKEFILE_HEADER

for TARGET_TO_GENERATE in $TARGETS_TO_GENERATE
do
  # Output the primary target
  echo -n "$TARGET_TO_GENERATE: " >> $MAKEFILE_PATH
  for TOOLCHAIN_SET in $ALL_TOOLCHAIN_SETS
  do
    if isIncluded "$toolchain_sets" "$TOOLCHAIN_SET" ; then
      if [ "$TARGET_TO_GENERATE" = "install" ] ; then
        # Output target name but setup dependencies as distinct sub-make commands
        # Otherwise, target names will be output with dependencies on a single line
        echo -n -e "\n\t\$(MAKE) "  >> $MAKEFILE_PATH
      fi
      echo -n " $TARGET_TO_GENERATE-$TOOLCHAIN_SET "  >> $MAKEFILE_PATH
    fi
  done
  echo >> $MAKEFILE_PATH

  # Output the related toolchain-set-specific targets  
  for TOOLCHAIN_SET in $ALL_TOOLCHAIN_SETS
  do
    cat >> $MAKEFILE_PATH <<MAKEFILE_TARGET_GEN
$TARGET_TO_GENERATE-$TOOLCHAIN_SET:
	@echo "MAKE: $TOOLCHAIN_SET - $TARGET_TO_GENERATE"   && cd "\$(BUILD_DIR)/${TOOLCHAIN_SET}"  && \$(MAKE) \$(${TOOLCHAIN_SET}_MAKE_ARGS)  $TARGET_TO_GENERATE
MAKEFILE_TARGET_GEN
  done

  # Output the .PHONY target
  echo -n ".PHONY: $TARGET_TO_GENERATE" >> $MAKEFILE_PATH
  for TOOLCHAIN_SET in $ALL_TOOLCHAIN_SETS
  do
    echo -n " ${TARGET_TO_GENERATE}-${TOOLCHAIN_SET}" >> $MAKEFILE_PATH
  done
  echo >> $MAKEFILE_PATH
  echo >> $MAKEFILE_PATH
done

# The ""dist" target require special handling
cat >> $MAKEFILE_PATH <<MAKEFILE_FOOTER
# Regarding this dist target comment, see the root Makefile.in for GCC
dist:
	@echo "Building a full distribution of this tree isn't done via 'make \$@'."
.PHONY:  dist


include Makefile.utility
MAKEFILE_FOOTER

# Include the utility Makefile
cp "$COMBINED_SRC_DIR/Makefile.utility" "$BUILD_DIR/"


# Execute configure scripts for the bundled projects

# For any quoted substrings in variables (such as $ARGS_TO_PASS might have)
#   to be properly processed as a single quoted argument,
#   the command must be eval'd instead of being executed directly.
#   c.f. https://stackoverflow.com/q/39583838/#comment66478321_39583915
if isIncluded "$toolchain_sets" "GDB5" ; then
  toolchain_set_id=gdb5
  echo "================="
  echo "CONFIGURE: GDB v5"
  GCC3_COMMAND="CFLAGS='-g -O2 -std=gnu89'  $COMBINED_SRC_DIR/${toolchain_set_id}/configure $ARGS_TO_PASS --disable-werror --prefix=$prefix --program-suffix=-5 "
  echo "COMMAND: $GCC3_COMMAND"
  mkdir -p "${BUILD_DIR}/${toolchain_set_id}" && pushd "${BUILD_DIR}/${toolchain_set_id}" > /dev/null
  eval "$GCC3_COMMAND" || exit 1
  popd > /dev/null
  
  # Since we are building GDB v5, set flags to exclude GDB v6 from the GCC-combined builds for GCC v3 and GCC v4.4
  FLAGS_IF_GDB5="--disable-sim --disable-gdb"
fi

# This step is only for a stand-alone BinUtils install and is _NOT_ for use when also building/installing one of the GCC toolchains
if isIncluded "$toolchain_sets" "BINUTILS216" ; then
  toolchain_set_id=binutils216
  echo "================="
  echo "CONFIGURE: BinUtils v2.16"
  BINUTILS216_COMMAND="CFLAGS='-g -O2 -std=gnu89'  $COMBINED_SRC_DIR/${toolchain_set_id}/configure $ARGS_TO_PASS --prefix=$prefix --program-suffix=-2.16.1 "
  echo "COMMAND: $BINUTILS216_COMMAND"
  mkdir -p "${BUILD_DIR}/${toolchain_set_id}" && pushd "${BUILD_DIR}/${toolchain_set_id}" > /dev/null
  eval "$BINUTILS216_COMMAND" || exit 1
  popd > /dev/null
fi

if isIncluded "$toolchain_sets" "GCC3" ; then
  # If building a separate GDB v5 instead of the combined GDB v6, then we can also skip building libdecnumber with GCC v3
  if [ "$FLAGS_IF_GDB5" != "" ] ; then
    GCC3_FLAGS_IF_GDB5="--disable-libdecnumber $FLAGS_IF_GDB5"
  else
    GCC3_FLAGS_IF_GDB5="$FLAGS_IF_GDB5"
  fi
  
  toolchain_set_id=gcc3
  echo "================="
  echo "CONFIGURE: GCC v3"
  GCC3_COMMAND="CFLAGS='-g -O2 -std=gnu89'  $COMBINED_SRC_DIR/${toolchain_set_id}/configure --enable-languages=$gcc3_languages $GCC3_FLAGS_IF_GDB5 $ARGS_TO_PASS --disable-werror --prefix=$prefix --program-suffix=-3 "
  echo "COMMAND: $GCC3_COMMAND"
  mkdir -p "${BUILD_DIR}/${toolchain_set_id}" && pushd "${BUILD_DIR}/${toolchain_set_id}" > /dev/null
  eval "$GCC3_COMMAND" || exit 1
  popd > /dev/null
fi

if isIncluded "$toolchain_sets" "GCC44" ; then
  toolchain_set_id=gcc44
  echo "==================="
  echo "CONFIGURE: GCC v4.4"
  GCC44_COMMAND="$COMBINED_SRC_DIR/${toolchain_set_id}/configure  CFLAGS='-g -O2 -std=gnu89'  --enable-languages=$gcc44_languages $FLAGS_IF_GDB5 $ARGS_TO_PASS --disable-werror --enable-obsolete --prefix=$prefix --program-suffix=-4.4 "
  echo "COMMAND: $GCC44_COMMAND"
  mkdir -p "${BUILD_DIR}/${toolchain_set_id}" && pushd "${BUILD_DIR}/${toolchain_set_id}" > /dev/null
  eval "$GCC44_COMMAND" || exit 1
  popd > /dev/null
fi
